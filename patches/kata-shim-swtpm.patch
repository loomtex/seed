+#swtpm_sentinel_path = "/var/lib/seed-controller/tpm/.seed-fs"
+# Ceph fsid of the shared TPM state filesystem. Required for tpm-mode.
+#swtpm_expected_fsid = ""
+# Seconds to wait for the session lock.
+#swtpm_lock_timeout = 120
