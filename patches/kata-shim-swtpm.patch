diff --git a/pkg/oci/seed_tpm_test.go b/pkg/oci/seed_tpm_test.go
new file mode 100644
index 000000000..7e1aa9096
--- /dev/null
+++ b/pkg/oci/seed_tpm_test.go
@@ -0,0 +1,77 @@
+// Copyright (c) 2026 Seed contributors
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+package oci
+
+import (
+	"strings"
+	"testing"
+
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"github.com/stretchr/testify/assert"
+
+	vc "github.com/kata-containers/kata-containers/src/runtime/virtcontainers"
+	vcAnnotations "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/annotations"
+)
+
+func TestAddSeedTpmOverrides(t *testing.T) {
+	fp := strings.Repeat("ab", 32)
+	dir := "/var/lib/seed-controller/tpm/s-gaydazldmnsg-social"
+
+	run := func(ann map[string]string) (vc.SandboxConfig, error) {
+		cfg := vc.SandboxConfig{Annotations: map[string]string{}}
+		err := addSeedTpmOverrides(specs.Spec{Annotations: ann}, &cfg)
+		return cfg, err
+	}
+
+	// absent: nothing happens
+	cfg, err := run(map[string]string{})
+	assert.NoError(t, err)
+	assert.Equal(t, "", cfg.HypervisorConfig.SeedTpmMode)
+
+	cfg, err = run(map[string]string{
+		vcAnnotations.SeedTpmMode:     "create",
+		vcAnnotations.SeedTpmStateDir: dir,
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, "create", cfg.HypervisorConfig.SeedTpmMode)
+	assert.Equal(t, dir, cfg.HypervisorConfig.SeedTpmStateDir)
+
+	cfg, err = run(map[string]string{
+		vcAnnotations.SeedTpmMode:        "verify",
+		vcAnnotations.SeedTpmStateDir:    dir,
+		vcAnnotations.SeedTpmFingerprint: fp,
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, fp, cfg.HypervisorConfig.SeedTpmFingerprint)
+
+	bad := []map[string]string{
+		{vcAnnotations.SeedTpmMode: "maybe", vcAnnotations.SeedTpmStateDir: dir},
+		{vcAnnotations.SeedTpmMode: "create"},
+		{vcAnnotations.SeedTpmMode: "create", vcAnnotations.SeedTpmStateDir: "relative/dir"},
+		{vcAnnotations.SeedTpmMode: "verify", vcAnnotations.SeedTpmStateDir: dir},
+	}
+	for _, ann := range bad {
+		_, err := run(ann)
+		assert.Error(t, err, ann)
+	}
+
+	// mutually exclusive with the legacy tpm_socket annotation
+	c := vc.SandboxConfig{Annotations: map[string]string{}}
+	c.HypervisorConfig.TpmSocket = "/run/swtpm/x/swtpm-sock"
+	err = addSeedTpmOverrides(specs.Spec{Annotations: map[string]string{
+		vcAnnotations.SeedTpmMode:     "create",
+		vcAnnotations.SeedTpmStateDir: dir,
+	}}, &c)
+	assert.Error(t, err)
+}
+
+// The seed.loom.farm/* keys are not io.katacontainers.config.hypervisor.*
+// keys, so enable_annotations must not filter them.
+func TestSeedTpmAnnotationsNotFiltered(t *testing.T) {
+	for _, k := range []string{vcAnnotations.SeedTpmMode, vcAnnotations.SeedTpmStateDir, vcAnnotations.SeedTpmFingerprint} {
+		assert.True(t, checkAnnotationNameIsValid([]string{"tpm_socket"}, k, vcAnnotations.KataAnnotationHypervisorPrefix), k)
+	}
+}
diff --git a/pkg/oci/utils.go b/pkg/oci/utils.go
index 217ebeb4b..b0ef96ada 100644
--- a/pkg/oci/utils.go
+++ b/pkg/oci/utils.go
@@ -578,6 +578,44 @@ func addHypervisorConfigOverrides(ocispec specs.Spec, config *vc.SandboxConfig,
 		}
 	}
 
+	if err := addSeedTpmOverrides(ocispec, config); err != nil {
+		return err
+	}
+
+	return nil
+}
+
+// addSeedTpmOverrides reads the seed.loom.farm/tpm-* annotations that make
+// the shim own the sandbox's swtpm (virtcontainers/swtpm.go).
+func addSeedTpmOverrides(ocispec specs.Spec, config *vc.SandboxConfig) error {
+	mode, ok := ocispec.Annotations[vcAnnotations.SeedTpmMode]
+	if !ok {
+		return nil
+	}
+	stateDir := ocispec.Annotations[vcAnnotations.SeedTpmStateDir]
+	fingerprint := ocispec.Annotations[vcAnnotations.SeedTpmFingerprint]
+
+	switch mode {
+	case vc.SeedTpmModeCreate, vc.SeedTpmModeVerify:
+	default:
+		return fmt.Errorf("annotation %s: invalid value %q (want %q or %q)",
+			vcAnnotations.SeedTpmMode, mode, vc.SeedTpmModeCreate, vc.SeedTpmModeVerify)
+	}
+	if stateDir == "" || !filepath.IsAbs(stateDir) {
+		return fmt.Errorf("annotation %s must be an absolute path, got %q", vcAnnotations.SeedTpmStateDir, stateDir)
+	}
+	if mode == vc.SeedTpmModeVerify && fingerprint == "" {
+		return fmt.Errorf("annotation %s is required when %s=%s",
+			vcAnnotations.SeedTpmFingerprint, vcAnnotations.SeedTpmMode, vc.SeedTpmModeVerify)
+	}
+	if config.HypervisorConfig.TpmSocket != "" {
+		return fmt.Errorf("annotations %s and %s are mutually exclusive",
+			vcAnnotations.SeedTpmMode, vcAnnotations.TpmSocket)
+	}
+
+	config.HypervisorConfig.SeedTpmMode = mode
+	config.HypervisorConfig.SeedTpmStateDir = stateDir
+	config.HypervisorConfig.SeedTpmFingerprint = fingerprint
 	return nil
 }
 
